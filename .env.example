# Développement local uniquement. Aucun fichier .env nécessaire avec Docker Compose.
POSTGRES_USER=sport
POSTGRES_PASSWORD=sport_local
POSTGRES_DB=sport
DB_PORT=5432
API_PORT=3000
# Utilisé pour un lancement Node hors Docker :
DATABASE_URL=postgres://sport:sport_local@localhost:5432/sport
PORT=3000

# Adresse de publication HTTP : localhost par défaut.
# Sur la VM du LAB, utiliser son IP privée pour un accès depuis le VPN.
API_BIND_ADDRESS=127.0.0.1
