{
  "name": "salle-de-sport-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:demo": "tsx scripts/seed-demo.ts",
    "test": "tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "format": "prettier --write src tests scripts db/seeds *.json *.yml *.md docs/*.md requests/*.md requests/*.json",
    "format:check": "prettier --check src tests scripts db/seeds *.json *.yml *.md docs/*.md requests/*.md requests/*.json",
    "demo": "tsx scripts/demo.ts"
  },
  "dependencies": {
    "express": "5.3.0",
    "luxon": "3.7.2",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/luxon": "3.7.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
